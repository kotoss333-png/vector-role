data_dir: "{{ vector_data_dir }}"

sources:
  demo_logs:
    type: demo_logs
    format: json
    interval: 1

sinks:
  clickhouse_sink:
    type: clickhouse
    inputs:
      - demo_logs
    endpoint: "http://{{ clickhouse_host }}:8123"
    database: logs
    table: demo_table
    skip_unknown_fields: true
